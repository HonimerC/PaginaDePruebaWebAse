{
  "name": "pino-caribe-landing",
  "private": true,
  "version": "1.0.0",
  "description": "Landing page Pino Caribe - industria forestal",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles.css -o ./styles.css --minify",
    "build:js": "esbuild src/app.js --bundle --minify --format=esm --outfile=app.js",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "tailwindcss -i ./src/styles.css -o ./styles.css --watch",
    "serve": "python -m http.server 4173"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "puppeteer-core": "^24.1.1",
    "tailwindcss": "^3.4.17"
  }
}
